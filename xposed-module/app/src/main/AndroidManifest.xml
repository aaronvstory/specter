<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- See EVERY installed app in the target-app picker. Android 11+ hides other packages by
         default; this app is a root/LSPosed tool whose whole job is to target arbitrary apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Diagnostics logging runs as a foreground service (continuous logcat capture to a file).
         DATA_SYNC subtype permission is required on Android 14+ (targetSdk 34+) or startForeground throws. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Protection-status screen fetches the current public (proxy exit) IP + its geolocation, so the
         user can confirm what the network reads as and align device timezone/locale to it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Specter"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Launcher UI. The app is BOTH an Xposed module and a launchable app, exactly like
             GeerGit — no PC needed to generate + apply identities. NoActionBar so our own header
             is the only title (was showing "Specter" twice). -->
        <!-- singleTop: without this, every launcher tap/relaunch (even while the app is already open in
             Recents) pushes a BRAND-NEW MainActivity instance on top instead of resuming the existing one:
             onCreate() runs fresh, discarding the in-memory current identity + applied state and firing an
             unwanted regenerate(). singleTop routes a relaunch to onResume() on the SAME instance instead,
             so the current identity/applied state survives. -->
        <activity
            android:name=".ui.MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Debug self-apply gate (non-launcher; kept for adb-driven testing). -->
        <activity
            android:name=".ui.DebugActivity"
            android:exported="true" />
        <!-- Target-app picker (opened from Settings). -->
        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false" />
        <!-- Live trace viewer (opened from Settings when diagnostics logging is on). -->
        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false" />
        <!-- Diagnostics logging: continuous logcat capture while the Settings toggle is ON. -->
        <service
            android:name=".ui.DiagnosticsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Xposed / LSPosed module markers -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Specter v0.3.0 — standalone on-device identifier rotation (GeerGit replacement). Generates + self-applies android_id, IMEI, serial, MACs, GSF, MediaDRM, advertising id, SIM + Build.* with no PC. Multi-app targeting, per-country SIM, per-id toggles. Scope target apps in LSPosed." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <!-- Zygisk/LSPosed scope hint: user picks apps in LSPosed UI -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
