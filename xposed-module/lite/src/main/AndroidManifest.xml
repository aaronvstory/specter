<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- READ_GSERVICES is a NORMAL (install-time, no user prompt) permission that the GSF gservices
         content provider requires; without it the gsf_id read throws SecurityException and is silently
         omitted. Everything else is read via a no-permission API (Settings.Secure, Build.*,
         ActivityManager, SensorManager, EGL, TelephonyManager operator strings) or omitted if
         unreadable. The profile is written to the app's OWN external files dir (no storage permission).
         Fields needing a privileged permission to read (IMEI/serial/IMSI/ICCID) are left for the user to
         hand-enter in Specter, never faked. The export now lands in public Download/Specter-exports/:
         API 29+ writes it via MediaStore (scoped storage, no permission); API 24–28 needs legacy
         WRITE_EXTERNAL_STORAGE (declared with maxSdkVersion=28 so it's inert on modern Android). -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="Specter Lite"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".HarvestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
